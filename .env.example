# Copie para .env. Nunca inclua service_role ou o segredo do Google.
NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:8080
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Alternativa legada: SUPABASE_ANON_KEY. Não use ambas.
# Produção: segredo aleatório base64 de 32 bytes (node -e ... no guia).
SESSION_SECRET=
SESSION_DAYS=30
PASSWORD_MIN_LENGTH=15
PASSWORD_RECOVERY_ENABLED=false
TERMS_PATH=/termos-de-uso
PRIVACY_PATH=/politica-de-privacidade
TERMS_VERSION=minuta-2026-10-12
PRIVACY_VERSION=minuta-2026-10-12
LEGAL_APPROVED=false
LEGAL_PUBLISHED=false
COMPANY_NAME=
COMPANY_DOCUMENT=
COMPANY_ADDRESS=
PRIVACY_CONTACT_EMAIL=
# Sem cobrança implementada. Entitlements permanecem controlados pelo servidor/DB.
